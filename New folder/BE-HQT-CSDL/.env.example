# Server
PORT=3001
NODE_ENV=development

# SQL Server
# Windows Auth (khuyến nghị trên Windows local):
DB_USE_WINDOWS_AUTH=true
DB_SERVER=localhost
DB_INSTANCE=SQLEXPRESS
DB_DATABASE=PharmacyFinance

# SQL Auth (nếu dùng user/password):
# DB_USE_WINDOWS_AUTH=false
# DB_SERVER=localhost
# DB_PORT=1433
# DB_USER=sa
# DB_PASSWORD=your_password_here

DB_TRUST_SERVER_CERTIFICATE=true
DB_ENCRYPT=false

# Datamart (tùy chọn - Analytics)
DATAMART_DATABASE=HQT_BanChuan

# JWT
JWT_SECRET=pharmacy_secret_key_change_in_production
JWT_EXPIRES_IN=8h

# CORS
CORS_ORIGIN=http://localhost:5173

# Groq API (tùy chọn)
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant
